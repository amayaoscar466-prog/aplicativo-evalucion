---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { login } from '../lib/api.js';

let error = '';

if (Astro.request.method === 'POST') {
  const datos = await Astro.request.formData();
  const correo = datos.get('correo');
  const password = datos.get('password');

  try {
    const { token } = await login(correo, password);
    Astro.cookies.set('token', token, { path: '/', httpOnly: true, sameSite: 'lax' });
    return Astro.redirect('/dashboard');
  } catch (e) {
  error = e instanceof Error ? e.message : 'No se pudo iniciar sesión';
}
}
---
<Layout>
  <main class="pantalla-centrada">
    <div class="ticket">
      <h1>Iniciar sesión</h1>
      {error && <p class="error-msg">{error}</p>}
      <form method="POST">
        <label>
          Correo electrónico
          <input type="email" name="correo" required />
        </label>
        <label>
          Contraseña
          <input type="password" name="password" required />
        </label>
        <button type="submit">Ingresar</button>
      </form>
      <p class="enlace-secundario">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
    </div>
  </main>
</Layout>